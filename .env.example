# Dialogue Studio — environment template (no secrets required).
# Backend actually loads: copy these keys to backend/.env
#   copy backend/.env.example backend/.env
# Frontend optional: copy VITE_API_URL into frontend/.env (Vite only reads frontend/.env).

# --- backend/.env (loaded by backend/app/config.py; does not override existing process env) ---
TTS_ENGINE=kokoro
DEFAULT_VOICE=af_heart
DEFAULT_SPEED=1.0
SPEAKER_CHANGE_PAUSE=2.5
OUTPUT_FORMAT=wav
KOKORO_DEVICE=auto
API_HOST=127.0.0.1
API_PORT=8000
MAX_LECTURE_CHARS=200000

# --- frontend/.env (optional) ---
VITE_API_URL=http://localhost:8000
