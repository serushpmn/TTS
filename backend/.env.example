# Loaded by app/config.py into Settings (os.environ.setdefault).
# KOKORO_DEVICE is used by Torch (auto → None) and reported on GET /api/health.
# TTS_ENGINE, DEFAULT_VOICE, DEFAULT_SPEED, SPEAKER_CHANGE_PAUSE, OUTPUT_FORMAT,
# API_HOST, API_PORT, MAX_LECTURE_CHARS are stored on Settings; npm run dev
# still binds 127.0.0.1:8000 from scripts/dev.mjs.

TTS_ENGINE=kokoro
DEFAULT_VOICE=af_heart
DEFAULT_SPEED=1.0
SPEAKER_CHANGE_PAUSE=2.5
OUTPUT_FORMAT=wav
KOKORO_DEVICE=auto
API_HOST=127.0.0.1
API_PORT=8000
MAX_LECTURE_CHARS=200000
